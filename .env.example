# Copy to .env and fill in only what you need.
#
#   cp .env.example .env
#
# Nothing here is required for a dry run — `gtm-enrich run --domains
# examples/domains.csv` works with this file untouched. Run `gtm-enrich check`
# at any point to see exactly what is wired up and what is not.
#
# Real environment variables always win over this file, so a value exported in
# your shell or set in CI is never silently overridden by a stale .env.

# ============================================================================
# Analysis — pick one provider. Anthropic is the default.
# ============================================================================
GTM_LLM_PROVIDER=anthropic          # anthropic | openai

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Leave GTM_MODEL empty to use the provider's default
# (claude-opus-5 for anthropic, gpt-5-mini for openai).
# GTM_MODEL=
# GTM_EFFORT=medium                 # low | medium | high | xhigh | max
# GTM_ENABLE_FALLBACKS=1            # Anthropic server-side refusal fallback

# ============================================================================
# Scraping — pick one backend. `direct` is the default and needs no key.
# ============================================================================
GTM_SCRAPER=direct                  # direct | firecrawl | crawl4ai | apify

# direct    — plain HTTP. Free, fast, no JavaScript.
# firecrawl — hosted, renders JavaScript, returns markdown.
FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://api.firecrawl.dev/v2/scrape

# crawl4ai — self-hosted; run the container, then point this at it:
#   docker run -d -p 11235:11235 unclecode/crawl4ai:latest
# CRAWL4AI_API_URL=http://localhost:11235/crawl
# CRAWL4AI_API_TOKEN=               # only if the server runs with JWT enabled

# apify — runs a crawler Actor and returns its dataset item.
APIFY_API_TOKEN=
# APIFY_ACTOR_ID=apify~website-content-crawler
# APIFY_RUN_TIMEOUT=120

# ============================================================================
# Destinations — dry run needs nothing.
# ============================================================================

# HubSpot private app token with crm.objects.companies.read + .write scopes.
HUBSPOT_PRIVATE_APP_TOKEN=

# Salesforce: either paste a session token...
SF_INSTANCE_URL=
SF_ACCESS_TOKEN=
# ...or use the OAuth 2.0 client credentials flow against a connected app.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# SF_LOGIN_URL=https://login.salesforce.com   # test.salesforce.com for a sandbox

# ============================================================================
# Scraper tuning
# ============================================================================
# GTM_SCRAPE_CONCURRENCY=5
# GTM_SCRAPE_TIMEOUT=20
# GTM_RESPECT_ROBOTS=1              # set to 0 only for sites you own
