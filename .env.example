# Copy to .env and fill in only what you need. Nothing here is required to run a
# dry run — `gtm-enrich run --domains examples/domains.csv` works with an empty file.

# ---- Analysis ---------------------------------------------------------------
# Without this, runs fall back to keyword heuristics and label them heuristic:v1.
ANTHROPIC_API_KEY=

# Optional overrides.
# GTM_MODEL=claude-opus-5          # claude-sonnet-5 or claude-haiku-4-5 for volume
# GTM_EFFORT=medium                # low | medium | high | xhigh | max
# GTM_ENABLE_FALLBACKS=1           # server-side refusal fallback

# ---- HubSpot ----------------------------------------------------------------
# Private app token with crm.objects.companies.read + .write scopes.
HUBSPOT_PRIVATE_APP_TOKEN=

# ---- Salesforce -------------------------------------------------------------
# Either paste a session token...
SF_INSTANCE_URL=
SF_ACCESS_TOKEN=
# ...or use the OAuth 2.0 client credentials flow against a connected app.
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# SF_LOGIN_URL=https://login.salesforce.com   # use test.salesforce.com for a sandbox

# ---- Scraper ----------------------------------------------------------------
# GTM_SCRAPE_CONCURRENCY=5
# GTM_SCRAPE_TIMEOUT=20
# GTM_RESPECT_ROBOTS=1             # set to 0 only for sites you own
